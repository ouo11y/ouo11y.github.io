    {
      "id": 23,
      "type": "table",
      "title": "Pods on this node",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (k8s_pod_name, k8s_namespace_name) (k8s_pod_cpu_usage{k8s_cluster_name=\"$cluster\", k8s_node_name=\"$node\"})",
          "refId": "A",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (k8s_pod_name, k8s_namespace_name) (k8s_pod_memory_working_set_bytes{k8s_cluster_name=\"$cluster\", k8s_node_name=\"$node\"})",
          "refId": "B",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "k8s_pod_name",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "k8s_namespace_name 2": true
            },
            "renameByName": {
              "k8s_pod_name": "Pod",
              "k8s_namespace_name 1": "Namespace",
              "Value #A": "CPU used",
              "Value #B": "Memory used"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Memory used"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Pod"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open pod",
                    "url": "/d/k8s-pod?var-cluster=$cluster&var-namespace=${__data.fields.Namespace}&var-pod=${__value.raw}&${__url_time_range}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
