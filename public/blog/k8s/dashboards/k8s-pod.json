        },
        "query": {
          "query": "label_values(k8s_pod_phase{k8s_cluster_name=\"$cluster\", k8s_namespace_name=\"$namespace\"}, k8s_pod_name)",
          "refId": "v"
        },
        "definition": "label_values(k8s_pod_phase{k8s_cluster_name=\"$cluster\", k8s_namespace_name=\"$namespace\"}, k8s_pod_name)",
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "hide": 0,
        "current": {},
        "options": []
