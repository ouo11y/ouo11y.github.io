    {
      "id": 46,
      "type": "stat",
      "title": "Waiting",
      "description": "Why a container is not running now (CrashLoopBackOff, ImagePullBackOff...), from the k8s.container.status.reason metric. Empty while every container runs.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 10,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (k8s_container_status_reason) (k8s_container_status_reason{k8s_cluster_name=\"$cluster\", k8s_namespace_name=\"$namespace\", k8s_pod_name=\"$pod\"} > 0)",
          "refId": "A",
          "legendFormat": "{{k8s_container_status_reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [],
