    {
      "id": 49,
      "type": "timeseries",
      "title": "CPU per container",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (k8s_container_name) (container_cpu_usage{k8s_cluster_name=\"$cluster\", k8s_namespace_name=\"$namespace\", k8s_pod_name=\"$pod\", k8s_container_name=~\"$container\"})",
          "refId": "A",
          "legendFormat": "{{k8s_container_name}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (k8s_container_name) (k8s_container_cpu_request{k8s_cluster_name=\"$cluster\", k8s_namespace_name=\"$namespace\", k8s_pod_name=\"$pod\", k8s_container_name=~\"$container\"})",
          "refId": "B",
          "legendFormat": "{{k8s_container_name}} request"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (k8s_container_name) (k8s_container_cpu_limit{k8s_cluster_name=\"$cluster\", k8s_namespace_name=\"$namespace\", k8s_pod_name=\"$pod\", k8s_container_name=~\"$container\"})",
          "refId": "C",
          "legendFormat": "{{k8s_container_name}} limit"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*(request|limit)$"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    6,
                    4
                  ]
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
