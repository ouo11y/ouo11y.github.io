{
  "uid": "k8s-pod",
  "title": "Kubernetes / Pod",
  "description": "One pod and its containers: usage against requests and limits, restarts, logs, traces, events.",
  "tags": [
    "kubernetes",
    "opentelemetry"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
