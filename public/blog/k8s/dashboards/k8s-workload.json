    {
      "id": 40,
      "type": "table",
      "title": "Pods",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (k8s_pod_name, k8s_node_name) (last_over_time(k8s_pod_phase{k8s_cluster_name=\"$cluster\", k8s_namespace_name=\"$namespace\", k8s_${kind}_name=\"$workload\"}[1m]))",
          "refId": "A",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (k8s_pod_name) (k8s_container_restarts{k8s_cluster_name=\"$cluster\", k8s_namespace_name=\"$namespace\", k8s_${kind}_name=\"$workload\"})",
          "refId": "B",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (k8s_pod_name) (k8s_pod_cpu_usage{k8s_cluster_name=\"$cluster\", k8s_namespace_name=\"$namespace\", k8s_${kind}_name=\"$workload\"})",
          "refId": "C",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (k8s_pod_name) (k8s_pod_memory_working_set_bytes{k8s_cluster_name=\"$cluster\", k8s_namespace_name=\"$namespace\", k8s_${kind}_name=\"$workload\"})",
          "refId": "D",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "k8s_pod_name",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "k8s_pod_name": "Pod",
              "k8s_node_name": "Node",
              "Value #A": "Phase",
              "Value #B": "Restarts",
              "Value #C": "CPU used",
              "Value #D": "Memory used"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Memory used"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Pod"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open pod",
                    "url": "/d/k8s-pod?var-cluster=$cluster&var-namespace=$namespace&var-pod=${__value.raw}&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Node"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open node",
                    "url": "/d/k8s-node?var-cluster=$cluster&var-node=${__value.raw}&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Phase"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "1": {
                        "text": "Pending"
                      },
                      "2": {
                        "text": "Running"
                      },
                      "3": {
                        "text": "Succeeded"
                      },
                      "4": {
                        "text": "Failed"
                      },
                      "5": {
                        "text": "Unknown"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 41,
      "type": "table",
      "title": "Traces",
      "description": "Recent traces from Tempo. Click a trace ID to open it.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "refId": "A",
          "queryType": "traceql",
          "query": "{resource.k8s.namespace.name=\"$namespace\" && resource.k8s.${kind}.name=\"$workload\"}",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 42,
      "type": "logs",
      "title": "Logs",
      "description": "Pod logs from the filelog receiver. A line with a trace id has an \"Open trace\" link.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
