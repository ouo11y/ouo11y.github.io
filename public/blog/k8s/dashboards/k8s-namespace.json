    {
      "id": 25,
      "type": "timeseries",
      "title": "CPU by workload",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (workload) (label_join(k8s_pod_cpu_usage{k8s_cluster_name=\"$cluster\", k8s_namespace_name=\"$namespace\"}, \"workload\", \"\", \"k8s_deployment_name\", \"k8s_statefulset_name\", \"k8s_daemonset_name\", \"k8s_job_name\"))",
          "refId": "A",
          "legendFormat": "{{workload}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 40,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
