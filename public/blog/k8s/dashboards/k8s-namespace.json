        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "k8s_deployment_name": "Name",
              "Value #A": "Desired",
              "Value #B": "Ready",
              "Value #C": "CPU used",
              "Value #D": "Memory used",
              "Value #E": "Restarts"
            }
