    {
      "id": 30,
      "type": "logs",
      "title": "Events in this namespace",
      "description": "Kubernetes events, collected by the k8s_objects receiver and stored in Loki.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{k8s_cluster_name=\"$cluster\", k8s_namespace_name=\"$namespace\", service_name=\"k8s-events\"} | json type=\"object.type\", reason=\"object.reason\", note=\"object.note\", kind=\"object.regarding.kind\", name=\"object.regarding.name\"  | line_format \"{{.type}} {{.kind}}/{{.name}} {{.reason}}: {{.note}}\"",
          "refId": "A",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none"
      }
    },
