        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Memory used"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Name"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open workload",
                    "url": "/d/k8s-workload?var-cluster=$cluster&var-namespace=$namespace&var-kind=deployment&var-workload=${__value.raw}&${__url_time_range}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
