    {
      "id": 11,
      "type": "logs",
      "title": "Warning events",
      "description": "Kubernetes events, collected by the k8s_objects receiver and stored in Loki.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{k8s_cluster_name=\"$cluster\", service_name=\"k8s-events\"} | json type=\"object.type\", reason=\"object.reason\", note=\"object.note\", kind=\"object.regarding.kind\", name=\"object.regarding.name\" | type=\"Warning\" | line_format \"{{.type}} {{.kind}}/{{.name}} {{.reason}}: {{.note}}\"",
