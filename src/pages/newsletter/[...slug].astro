---
import Post from '../../layouts/Post.astro';
import Follow from '../../components/newsletter/Follow.astro';
import InThisIssue from '../../components/newsletter/InThisIssue.astro';
import { listPosts } from '../../lib/site';

export async function getStaticPaths() {
  const entries = await listPosts('newsletter');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { issue, inThisIssue } = entry.data;
---
<Post section="newsletter" entry={entry}>
  {inThisIssue && <InThisIssue slot="before" issue={issue} items={inThisIssue} />}
  <Follow slot="after" compact />
</Post>
