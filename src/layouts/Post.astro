---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import Base from './Base.astro';
import { fmtDate, listPosts, readingTime, sections, seriesIn, shortTitle, slugify, type Section } from '../lib/site';

interface Props { section: Section; entry: CollectionEntry<Section>; }
const { section, entry } = Astro.props;
const { Content, headings } = await render(entry);
const { title, description, date, updated, authors, tags, series, part } = entry.data;
const minutes = readingTime(entry.body);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);

const all = await listPosts(section);
const thisSeries = series ? seriesIn(all).find((s) => s.slug === slugify(series)) : undefined;
const idx = all.findIndex((e) => e.id === entry.id);
const newer = idx > 0 ? all[idx - 1] : undefined;
const older = idx >= 0 && idx < all.length - 1 ? all[idx + 1] : undefined;
const seriesIdx = thisSeries?.posts.findIndex((p) => p.id === entry.id) ?? -1;
const prevPart = thisSeries && seriesIdx > 0 ? thisSeries.posts[seriesIdx - 1] : undefined;
const nextPart = thisSeries && seriesIdx >= 0 && seriesIdx < thisSeries.posts.length - 1 ? thisSeries.posts[seriesIdx + 1] : undefined;
---
<Base title={title} description={description}>
  <article class="post">
    <header class="post-head wrap">
      <p class="eyebrow">
        <a href={`/${section}/`}>{sections[section].title}</a>
        {thisSeries && <> · <a href={`/${section}/series/${thisSeries.slug}/`}>{thisSeries.title}</a>{part && <>, part {part}</>}</>}
      </p>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
      <p class="meta">
        {fmtDate(date)}{updated && <> · updated {fmtDate(updated)}</>} · {minutes} min read · {authors.join(', ')}
      </p>
      {tags.length > 0 && <p class="tags">{tags.map((t) => <a class="tag" href={`/${section}/?tag=${encodeURIComponent(t)}`}>{t}</a>)}</p>}
    </header>

    <div class="post-body wrap">
      <aside class="toc" aria-label="On this page">
        {thisSeries && (
          <nav class="series-box">
            <p class="box-title"><a href={`/${section}/series/${thisSeries.slug}/`}>{thisSeries.title}</a></p>
            <ol>
              {thisSeries.posts.map((p) => (
                <li class:list={{ here: p.id === entry.id }}>
                  {p.id === entry.id ? <span>{shortTitle(p.data.title, thisSeries.title)}</span> : <a href={`/${section}/${p.id}/`}>{shortTitle(p.data.title, thisSeries.title)}</a>}
                </li>
              ))}
            </ol>
          </nav>
        )}
        {toc.length > 1 && (
          <nav class="toc-box">
            <p class="box-title">On this page</p>
            <ul>{toc.map((h) => <li class={`d${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul>
          </nav>
        )}
      </aside>

      <div class="prose"><slot name="before" /><Content /><slot name="after" /></div>
    </div>

    <footer class="wrap post-foot">
      {(prevPart || nextPart) && (
        <div class="pager">
          {prevPart ? <a class="page prev" href={`/${section}/${prevPart.id}/`}><small>← Part {prevPart.data.part}</small>{prevPart.data.title}</a> : <span />}
          {nextPart ? <a class="page next" href={`/${section}/${nextPart.id}/`}><small>Part {nextPart.data.part} →</small>{nextPart.data.title}</a> : <span />}
        </div>
      )}
      <div class="pager">
        {older ? <a class="page prev" href={`/${section}/${older.id}/`}><small>← Older</small>{older.data.title}</a> : <span />}
        {newer ? <a class="page next" href={`/${section}/${newer.id}/`}><small>Newer →</small>{newer.data.title}</a> : <span />}
      </div>
      <p class="meta">Spotted a mistake, or want the next part sooner? <a href="mailto:hello@ouo11y.com">hello@ouo11y.com</a> · <a href={`/${section}/rss.xml`}>RSS</a></p>
    </footer>
  </article>
</Base>

<style>
  .post-head { max-width: 1180px; padding-top: 64px; padding-bottom: 24px; }
  .post-head h1 { font-size: clamp(30px, 5vw, 48px); max-width: 860px; margin-top: 8px; }
  .post-head .lede { max-width: 760px; }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .tags .tag:hover { text-decoration: none; filter: brightness(1.1); }
  .post-body { max-width: 1180px; display: grid; grid-template-columns: minmax(0, 1fr) 260px; gap: 56px; align-items: start; }
  .post-body .prose { grid-column: 1; grid-row: 1; max-width: 760px; min-width: 0; }
  .toc { grid-column: 2; grid-row: 1; position: sticky; top: 84px; max-height: calc(100vh - 100px); overflow: auto; font-size: 14px; display: grid; gap: 20px; }
  .box-title { font-size: 12px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--ink-3); margin: 0 0 8px; }
  .box-title a { color: inherit; }
  .toc ul, .toc ol { margin: 0; padding: 0; list-style: none; display: grid; gap: 6px; }
  .toc a { color: var(--ink-2); }
  .toc a:hover { color: var(--ink); text-decoration: none; }
  .toc .d3 { padding-left: 12px; font-size: 13px; }
  .series-box { padding: 14px 16px; border: 1px solid var(--line); border-radius: 12px; background: var(--bg-2); }
  .series-box ol { counter-reset: part; }
  .series-box li { counter-increment: part; display: grid; grid-template-columns: 22px 1fr; }
  .series-box li::before { content: counter(part); color: var(--ink-3); font-variant-numeric: tabular-nums; }
  .series-box li.here span { color: var(--ink); font-weight: 600; }
  .post-foot { max-width: 1180px; margin-top: 56px; display: grid; gap: 16px; }
  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; max-width: 760px; }
  .page { display: grid; gap: 4px; padding: 14px 16px; border: 1px solid var(--line); border-radius: 12px; background: var(--bg-2); color: var(--ink); font-weight: 600; }
  .page small { color: var(--ink-3); font-weight: 400; }
  .page.next { text-align: right; }
  .page:hover { text-decoration: none; border-color: var(--ink-3); }
  @media (max-width: 1000px) {
    .post-body { grid-template-columns: minmax(0, 1fr); gap: 24px; }
    .toc { grid-column: 1; grid-row: 1; position: static; max-height: none; }
    .toc-box { display: none; }
    .post-body .prose { grid-row: 2; }
  }
  @media (max-width: 560px) { .pager { grid-template-columns: 1fr; } .page.next { text-align: left; } }
</style>
