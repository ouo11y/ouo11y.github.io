---
// A download button for a quickstart's finished files, zipped at build time by scripts/zip-quickstarts.mjs.
interface Props { qs: string; label?: string; }
const { qs, label = 'Download the finished files' } = Astro.props;
---
<a class="qs-download" href={`/downloads/${qs}.zip`} download>⬇ {label} <small>({qs}.zip)</small></a>

<style>
  .qs-download { display: inline-flex; gap: .5rem; align-items: center; padding: .55rem 1rem; border-radius: .6rem; border: 1px solid var(--sl-color-accent); background: var(--sl-color-accent-low); color: var(--sl-color-white); text-decoration: none; font-weight: 600; font-size: .95rem; }
  .qs-download small { font-weight: 400; color: var(--sl-color-gray-3); }
</style>
