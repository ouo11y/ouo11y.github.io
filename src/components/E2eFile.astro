---
// Embeds a file of the end-to-end blog project (blog-sources/e2e/) as a code block titled with
// its path, so readers copy it from the post. The whole folder is public/blog/e2e/blog-e2e.zip.
// <E2eFile path="compose.yaml" />
import { Code } from '@astrojs/starlight/components';

interface Props { path: string; title?: string; lang?: string; open?: boolean; }
const { path, title, lang, open = true } = Astro.props;
const files = import.meta.glob(['/blog-sources/e2e/**/*', '!/blog-sources/e2e/**/node_modules/**'], { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const code = files[`/blog-sources/e2e/${path}`];
if (code === undefined) throw new Error(`E2eFile: /blog-sources/e2e/${path} not found`);
const ext = path.split('.').pop() ?? '';
const langs: Record<string, string> = { js: 'js', py: 'python', yaml: 'yaml', yml: 'yaml', json: 'json', html: 'html', sql: 'sql', txt: 'txt', md: 'md', Dockerfile: 'dockerfile' };
const name = path.split('/').pop() ?? path;
const display = title ?? `blog-e2e/${path}`;
---
<details class="e2e-file" open={open}>
  <summary><code>{display}</code></summary>
  <Code code={code.replace(/\n$/, '')} lang={lang ?? langs[name] ?? langs[ext] ?? 'txt'} title={display} />
</details>

<style>
  .e2e-file { margin: 1rem 0; }
  .e2e-file > summary { cursor: pointer; font-size: .9rem; color: var(--sl-color-gray-2, var(--ink-2)); margin-bottom: .5rem; }
</style>
