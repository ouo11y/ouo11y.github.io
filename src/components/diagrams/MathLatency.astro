---
// 2,000 request latencies as a histogram, with the mean, p50, p95 and p99 marked. Sliders change
// the share and the speed of the slow tail (a little JS); without JS it shows the props.
// <MathLatency tail={0.02} tailMs={1200} />
import '../../styles/diagram.css';
import { latencySample, latencySvg, mean, quantile, fmtMs } from './MathLib';

interface Props { tail?: number; tailMs?: number; caption?: string; }
const { tail = 0.02, tailMs = 1200, caption } = Astro.props;
const xs = latencySample(tail, tailMs);
const stats = [
  { key: 'mean', label: 'mean', value: mean(xs), tone: 'info' },
  { key: 'p50', label: 'p50', value: quantile(xs, 0.5), tone: 'ok' },
  { key: 'p95', label: 'p95', value: quantile(xs, 0.95), tone: 'warn' },
  { key: 'p99', label: 'p99', value: quantile(xs, 0.99), tone: 'bad' },
];
---
<figure class="dg mlat not-content" data-mlat>
  <div class="ctl">
    <label>Slow requests <output data-out="t">{(tail * 100).toFixed(1)}%</output>
      <input type="range" min="0" max="0.1" step="0.005" value={tail} data-in="t" /></label>
    <label>How slow they are <output data-out="m">{fmtMs(tailMs)}</output>
      <input type="range" min="200" max="5000" step="100" value={tailMs} data-in="m" /></label>
  </div>
  <svg viewBox="0 0 720 260" role="img" aria-label="Histogram of request latency on a log scale, with mean and percentiles marked" set:html={latencySvg(xs, stats)} />
  <dl class="stats" aria-live="polite">
    {stats.map((s) => <div class={`tone-${s.tone}`}><dt>{s.label}</dt><dd data-stat={s.key}>{fmtMs(s.value)}</dd></div>)}
  </dl>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
  import { latencySample, latencySvg, mean, quantile, fmtMs } from './MathLib';
  for (const fig of document.querySelectorAll<HTMLElement>('[data-mlat]')) {
    const t = fig.querySelector<HTMLInputElement>('[data-in="t"]')!;
    const m = fig.querySelector<HTMLInputElement>('[data-in="m"]')!;
    const svg = fig.querySelector('svg')!;
    const update = () => {
      const xs = latencySample(+t.value, +m.value);
      const stats = [
        { key: 'mean', label: 'mean', value: mean(xs), tone: 'info' },
        { key: 'p50', label: 'p50', value: quantile(xs, 0.5), tone: 'ok' },
        { key: 'p95', label: 'p95', value: quantile(xs, 0.95), tone: 'warn' },
        { key: 'p99', label: 'p99', value: quantile(xs, 0.99), tone: 'bad' },
      ];
      svg.innerHTML = latencySvg(xs, stats);
      for (const s of stats) fig.querySelector(`[data-stat="${s.key}"]`)!.textContent = fmtMs(s.value);
      fig.querySelector('[data-out="t"]')!.textContent = `${(+t.value * 100).toFixed(1)}%`;
      fig.querySelector('[data-out="m"]')!.textContent = fmtMs(+m.value);
    };
    t.addEventListener('input', update);
    m.addEventListener('input', update);
  }
</script>

<style>
  .ctl { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 10px 20px; margin-bottom: 8px; }
  .ctl label { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 2px 8px; font-size: 13px; }
  .ctl input { grid-column: 1 / -1; width: 100%; accent-color: var(--dg-accent); }
  .ctl output { font-weight: 700; font-variant-numeric: tabular-nums; }
  svg { width: 100%; height: auto; display: block; }
  svg :global(.bar) { fill: color-mix(in srgb, var(--dg-accent) 55%, transparent); }
  svg :global(.tick) { stroke: var(--dg-line); }
  svg :global(text) { font-size: 12px; fill: var(--dg-ink-3); }
  svg :global(.mk line) { stroke: var(--tone); stroke-width: 2; }
  svg :global(.mk text) { fill: var(--tone); font-weight: 700; font-size: 13px; }
  .stats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; margin: 10px 0 0; }
  .stats div { padding: 8px 10px; border-radius: 8px; border-left: 3px solid var(--tone); background: var(--dg-node); }
  .stats dt { font-size: 12px; color: var(--dg-ink-3); }
  .stats dd { margin: 0; font-weight: 700; font-variant-numeric: tabular-nums; color: var(--tone); }
  .mlat :global(.tone-info) { --tone: var(--dg-info); }
  .mlat { container-type: inline-size; }
  @container (max-width: 420px) { .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); } svg :global(.mk text) { display: none; } }
  input:focus-visible { outline: 2px solid var(--dg-accent); outline-offset: 2px; }
</style>
