---
// Step through OTTL statements and watch one record change. Each step carries the record as it is
// after that statement; rows that changed are highlighted, rows that went away are struck out.
// <OtelOttlSteps steps={[{ code: 'set(...)', note: '...', record: { Resource: [['service.name', 'checkout']] }, changed: ['service.name'], removed: [] }]} />
import '../../styles/diagram.css';

interface Step { code: string; note: string; ctx?: string; record: Record<string, [string, string][]>; changed?: string[]; removed?: string[]; }
interface Props { steps: Step[]; caption?: string; }
const { steps, caption } = Astro.props;
---
<figure class="dg ottl not-content" data-ottl>
  <div class="bar">
    <button type="button" class="nav" data-d="-1" aria-label="Previous statement">←</button>
    <span class="count" aria-live="polite"><b>0</b> / {steps.length - 1}</span>
    <button type="button" class="nav" data-d="1" aria-label="Next statement">→</button>
    <input type="range" min="0" max={steps.length - 1} value="0" aria-label="Statement" />
  </div>
  {steps.map((s, i) => (
    <div class="step" data-i={i} hidden={i !== 0}>
      <div class="stmt">
        {s.ctx && <span class="ctx">{s.ctx}</span>}
        <code>{s.code}</code>
        <p set:html={s.note} />
      </div>
      <div class="rec">
        {Object.entries(s.record).map(([section, rows]) => (
          <div class="sec">
            <div class="sec-name">{section}</div>
            {rows.length === 0 && <div class="row empty">(none)</div>}
            {rows.map(([k, v]) => (
              <div class:list={['row', { changed: s.changed?.includes(k), removed: s.removed?.includes(k) }]}>
                <span class="k">{k}</span><span class="v">{v}</span>
              </div>
            ))}
          </div>
        ))}
      </div>
    </div>
  ))}
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
  for (const fig of document.querySelectorAll<HTMLElement>('[data-ottl]')) {
    const steps = [...fig.querySelectorAll<HTMLElement>('.step')];
    const range = fig.querySelector<HTMLInputElement>('input[type=range]')!;
    const count = fig.querySelector('.count b')!;
    let i = 0;
    const show = (n: number) => {
      i = Math.max(0, Math.min(steps.length - 1, n));
      steps.forEach((s, j) => (s.hidden = j !== i));
      range.value = String(i);
      count.textContent = String(i);
    };
    fig.querySelectorAll<HTMLButtonElement>('.nav').forEach((b) => b.addEventListener('click', () => show(i + +b.dataset.d!)));
    range.addEventListener('input', () => show(+range.value));
  }
</script>

<style>
  .bar { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; }
  .nav { font: inherit; font-size: 16px; width: 36px; height: 32px; border-radius: 8px; border: 1px solid var(--dg-line); background: var(--dg-node); color: var(--dg-ink); cursor: pointer; }
  .nav:hover { border-color: var(--dg-accent); }
  .count { font-size: 13px; color: var(--dg-ink-3); min-width: 48px; text-align: center; }
  .count b { color: var(--dg-ink); }
  input[type=range] { flex: 1; min-width: 0; accent-color: var(--dg-accent); }
  .step { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: 16px; }
  .step[hidden] { display: none; }
  .stmt { min-width: 0; }
  .ctx { display: inline-block; font-size: 11px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--dg-accent); margin-bottom: 6px; }
  .stmt code { display: block; padding: 10px 12px; border-radius: 8px; background: var(--dg-node); border: 1px solid var(--dg-line); font-size: 12.5px; line-height: 1.5; white-space: pre-wrap; overflow-wrap: anywhere; }
  .stmt p { margin: 10px 0 0; color: var(--dg-ink-2); font-size: 13.5px; }
  .rec { min-width: 0; display: grid; gap: 10px; align-content: start; }
  .sec-name { font-size: 11px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--dg-ink-3); margin-bottom: 4px; }
  .row { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); gap: 8px; padding: 4px 8px; border-radius: 6px; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12px; }
  .row:nth-child(odd) { background: color-mix(in srgb, var(--dg-node) 70%, transparent); }
  .k { color: var(--dg-ink-2); overflow-wrap: anywhere; }
  .v { overflow-wrap: anywhere; }
  .row.changed { background: color-mix(in srgb, var(--dg-ok) 16%, transparent); box-shadow: inset 3px 0 0 var(--dg-ok); }
  .row.removed { background: color-mix(in srgb, var(--dg-bad) 12%, transparent); box-shadow: inset 3px 0 0 var(--dg-bad); text-decoration: line-through; opacity: .75; }
  .row.empty { color: var(--dg-ink-3); font-style: italic; }
  .ottl { container-type: inline-size; }
  @container (max-width: 620px) { .step { grid-template-columns: 1fr; } .row { grid-template-columns: 1fr; gap: 0; } }
</style>
