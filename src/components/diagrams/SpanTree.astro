---
// One trace as Tempo draws it: a row per span, indented by depth, with its service and a bar on a shared time axis.
// Pure HTML and CSS; on narrow screens the bars move under the span names.
// <SpanTree duration={200} spans={[{ name: 'POST', service: 'tiny-shop-frontend', depth: 0, from: 0, to: 190 }]} />
import '../../styles/diagram.css';

type Tone = 'accent' | 'ok' | 'warn' | 'bad' | 'info';
interface Span { name: string; service?: string; depth: number; from: number; to: number; note?: string; tone?: Tone; events?: { at: number; label: string }[]; }
interface Props { duration: number; unit?: string; spans: Span[]; caption?: string; }
const { duration, unit = 'ms', spans, caption } = Astro.props;
const pct = (t: number) => (t / duration) * 100;
---
<figure class="dg st not-content">
  <ol class="spans">
    {spans.map((s) => (
      <li class:list={['span', `tone-${s.tone ?? (s.service?.endsWith('frontend') ? 'info' : 'accent')}`]} style={`--d:${s.depth}`}>
        <div class="name">
          <span class="branch" aria-hidden="true" />
          <span class="text">
            {s.service && <span class="svc">{s.service}</span>}
            <code>{s.name}</code>
            {s.note && <small>{s.note}</small>}
          </span>
        </div>
        <div class="track">
          <span class="bar" style={`left:${pct(s.from)}%;width:max(4px, ${pct(s.to) - pct(s.from)}%)`} />
          {s.events?.map((e) => <span class="ev" style={`left:${pct(e.at)}%`} title={e.label} />)}
        </div>
        <span class="dur">{s.to - s.from} {unit}</span>
      </li>
    ))}
  </ol>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .st { container-type: inline-size; }
  .spans { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 4px; }
  .span { display: grid; grid-template-columns: minmax(0, 46%) minmax(0, 1fr) 48px; gap: 10px; align-items: center; padding: 4px 6px; border-radius: 8px; }
  .span:hover { background: var(--dg-accent-soft); }
  .name { display: flex; align-items: center; min-width: 0; padding-left: calc(var(--d) * 16px); }
  .branch { flex: 0 0 10px; height: 10px; margin-right: 6px; border-left: 1.5px solid var(--dg-line); border-bottom: 1.5px solid var(--dg-line); border-bottom-left-radius: 3px; }
  .span[style*="--d:0"] .branch { border: 0; flex-basis: 0; margin: 0; }
  .text { display: flex; flex-wrap: wrap; align-items: baseline; gap: 2px 6px; min-width: 0; }
  .text code { overflow-wrap: anywhere; background: none; padding: 0; color: var(--dg-ink); }
  .svc { font-size: 11px; font-weight: 600; padding: 0 6px; border-radius: 99px; color: var(--tone); border: 1px solid color-mix(in srgb, var(--tone) 45%, transparent); }
  .text small { flex-basis: 100%; font-size: 12px; color: var(--dg-ink-3); }
  .track { position: relative; height: 22px; border-left: 1px solid var(--dg-line); }
  .bar { position: absolute; top: 5px; height: 12px; border-radius: 4px; background: var(--tone); opacity: .85; }
  .ev { position: absolute; top: 2px; width: 2px; height: 18px; margin-left: -1px; background: var(--dg-ink); border-radius: 1px; }
  .dur { font-size: 11px; color: var(--dg-ink-3); text-align: right; font-variant-numeric: tabular-nums; }
  @container (max-width: 520px) {
    .span { grid-template-columns: minmax(0, 1fr) 44px; gap: 2px 8px; }
    .name { grid-column: 1 / -1; }
    .track { margin-left: calc(var(--d) * 16px); }
  }
</style>
