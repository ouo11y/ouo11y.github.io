---
// An interactive history: a proportional strip of years with one dot per event, filter chips by
// kind, and the event list below. Click a dot or a row to open it. Stacks cleanly at 375 px.
// <OtelHistoryTimeline events={[{ date: '2019-05-21', label: 'May 2019', title: '...', kind: 'project', body: '...', href: '...' }]} />
import '../../styles/diagram.css';

type Kind = 'project' | 'signal' | 'governance' | 'deprecation';
interface Event { date: string; label: string; title: string; kind: Kind; body: string; href?: string; source?: string; }
interface Props { events: Event[]; caption?: string; }
const { events, caption } = Astro.props;

const kinds: { id: Kind; name: string; tone: string }[] = [
  { id: 'project', name: 'Projects', tone: 'accent' },
  { id: 'signal', name: 'Signals and specs', tone: 'ok' },
  { id: 'governance', name: 'CNCF', tone: 'info' },
  { id: 'deprecation', name: 'Retired', tone: 'warn' },
];
const toneOf = (k: Kind) => kinds.find((x) => x.id === k)!.tone;
const t = (d: string) => new Date(d + (d.length === 7 ? '-15' : '')).getTime();
const first = new Date('2010-01-01').getTime(), last = new Date('2027-01-01').getTime();
const pos = (d: string) => ((t(d) - first) / (last - first)) * 100;
const years = Array.from({ length: 17 }, (_, i) => 2010 + i);
const sorted = [...events].sort((a, b) => t(a.date) - t(b.date));
---
<figure class="dg otl not-content" data-otl>
  <div class="chips" role="group" aria-label="Filter events">
    <button type="button" class="chip on" data-k="all" aria-pressed="true">All</button>
    {kinds.map((k) => <button type="button" class={`chip tone-${k.tone}`} data-k={k.id} aria-pressed="false"><i />{k.name}</button>)}
  </div>

  <div class="strip" aria-hidden="true">
    <div class="axis" />
    {years.map((y) => <span class:list={['yr', { major: y % 2 === 0 }]} style={`left:${pos(`${y}-01-01`)}%`}>{y % 2 === 0 ? `'${String(y).slice(2)}` : ''}</span>)}
    {sorted.map((e, i) => <button type="button" tabindex="-1" class={`dot tone-${toneOf(e.kind)}`} data-i={i} data-kind={e.kind} style={`left:${pos(e.date)}%`} title={`${e.label}: ${e.title}`} />)}
  </div>

  <ol class="events">
    {sorted.map((e, i) => (
      <li class={`ev tone-${toneOf(e.kind)}`} data-i={i} data-kind={e.kind}>
        <button type="button" class="head" aria-expanded="false">
          <span class="when">{e.label}</span>
          <span class="what">{e.title}</span>
        </button>
        <div class="detail" hidden>
          <p set:html={e.body} />
          {e.href && <a href={e.href} rel="noopener">{e.source ?? 'Source'} ↗</a>}
        </div>
      </li>
    ))}
  </ol>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
  for (const fig of document.querySelectorAll<HTMLElement>('[data-otl]')) {
    const rows = [...fig.querySelectorAll<HTMLElement>('.ev')];
    const dots = [...fig.querySelectorAll<HTMLElement>('.dot')];
    const open = (i: number, scroll = false) => {
      rows.forEach((r) => {
        const on = r.dataset.i === String(i) && r.querySelector('.detail')!.hasAttribute('hidden');
        r.classList.toggle('open', on);
        r.querySelector('.detail')!.toggleAttribute('hidden', !on);
        r.querySelector('.head')!.setAttribute('aria-expanded', String(on));
        if (on && scroll) r.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
      });
      dots.forEach((d) => d.classList.toggle('sel', d.dataset.i === String(i) && rows[i].classList.contains('open')));
    };
    rows.forEach((r) => r.querySelector('.head')!.addEventListener('click', () => open(+r.dataset.i!)));
    dots.forEach((d) => d.addEventListener('click', () => open(+d.dataset.i!, true)));
    for (const chip of fig.querySelectorAll<HTMLButtonElement>('.chip')) {
      chip.addEventListener('click', () => {
        const k = chip.dataset.k!;
        fig.querySelectorAll('.chip').forEach((c) => { c.classList.toggle('on', c === chip); c.setAttribute('aria-pressed', String(c === chip)); });
        for (const el of [...rows, ...dots]) el.classList.toggle('dim', k !== 'all' && el.dataset.kind !== k);
        rows.forEach((r) => (r.hidden = k !== 'all' && r.dataset.kind !== k));
      });
    }
  }
</script>

<style>
  .chips { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 18px; }
  .chip { font: inherit; font-size: 13px; padding: 5px 12px; border-radius: 999px; border: 1px solid var(--dg-line); background: var(--dg-node); color: var(--dg-ink-2); cursor: pointer; display: inline-flex; align-items: center; gap: 6px; }
  .chip i { width: 9px; height: 9px; border-radius: 50%; background: var(--tone); }
  .chip.on { border-color: var(--dg-accent); color: var(--dg-ink); background: var(--dg-accent-soft); font-weight: 600; }
  .strip { position: relative; height: 54px; margin: 0 10px 14px; }
  .axis { position: absolute; left: 0; right: 0; top: 18px; height: 2px; background: var(--dg-line); }
  .yr { position: absolute; top: 30px; transform: translateX(-50%); font-size: 11px; color: var(--dg-ink-3); }
  .yr::before { content: ""; position: absolute; left: 50%; top: -14px; width: 1px; height: 6px; background: var(--dg-line); }
  .dot { position: absolute; top: 12px; width: 14px; height: 14px; margin-left: -7px; padding: 0; border-radius: 50%; border: 2px solid var(--dg-bg); background: var(--tone); cursor: pointer; transition: transform .15s, opacity .15s; }
  .dot:hover, .dot.sel { transform: scale(1.45); z-index: 1; }
  .dot.dim { opacity: .15; }
  .events { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; max-height: 520px; overflow-y: auto; }
  .ev { border-left: 3px solid var(--tone); border-radius: 0 8px 8px 0; background: var(--dg-node); }
  .ev.open { background: color-mix(in srgb, var(--tone) 9%, var(--dg-node)); }
  .head { all: unset; box-sizing: border-box; width: 100%; display: grid; grid-template-columns: 92px minmax(0, 1fr); gap: 10px; padding: 8px 12px; cursor: pointer; }
  .head:focus-visible { outline: 2px solid var(--dg-accent); outline-offset: -2px; }
  .when { font-size: 12px; font-weight: 700; color: var(--tone); padding-top: 1px; }
  .what { font-weight: 600; overflow-wrap: anywhere; }
  .detail { padding: 0 12px 10px 114px; color: var(--dg-ink-2); font-size: 13.5px; }
  .detail p { margin: 0 0 6px; }
  .detail a { font-size: 13px; color: var(--dg-accent); }
  @media (max-width: 560px) {
    .strip { display: none; }
    .head { grid-template-columns: 1fr; gap: 2px; }
    .detail { padding-left: 12px; }
  }
</style>
